<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- 日志存放路径，与 logging.file.path / LOG_PATH 保持一致 -->
    <property name="log.path" value="${LOG_PATH:-logs}" />
    <!-- 文件与实时日志共用同一格式，INFO / WARN / ERROR 都落在这一个文件里 -->
    <property name="log.pattern" value="%d{yyyy-MM-dd HH:mm:ss.SSS,CTT} [%thread] %-5level %logger{36} - [%method,%line] - %msg%n" />
    <property name="log.console-pattern" value="%green(%d{MM-dd HH:mm:ss.SSS}) %yellow([%thread]) %green([%X{flag}]) %highlight(%-5level) %cyan(%logger{20}:%L) -> %magenta(%msg) %n" />

    <!-- 控制台输出 -->
    <appender name="console" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${log.console-pattern}</pattern>
        </encoder>
    </appender>

    <!-- 全部级别写入同一个按天 + 大小滚动的文件：gateway-yyyy-MM-dd.i.log -->
    <appender name="file_all" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${log.path}/gateway-%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>100MB</maxFileSize>
            <maxHistory>15</maxHistory>
            <totalSizeCap>2GB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>${log.pattern}</pattern>
            <charset>UTF-8</charset>
        </encoder>
        <!-- DEBUG 仍只在控制台出现；INFO、WARN、ERROR 进同一个文件 -->
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>INFO</level>
        </filter>
    </appender>

    <!-- 推到实时日志页面，不另存文件 -->
    <appender name="web_log" class="com.zhian.gateway.framework.log.WebLogAppender">
        <pattern>${log.pattern}</pattern>
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>INFO</level>
        </filter>
    </appender>

    <!-- 具体级别以 application.yml 的 logging.level 为准，这里只给默认值 -->
    <logger name="com.zhian" level="info" />
    <logger name="org.springframework" level="warn" />

    <root level="info">
        <appender-ref ref="console" />
        <appender-ref ref="file_all" />
        <appender-ref ref="web_log" />
    </root>
</configuration>
