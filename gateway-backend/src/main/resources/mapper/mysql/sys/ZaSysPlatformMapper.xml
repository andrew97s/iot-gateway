<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.zhian.gateway.sys.mapper.ZaSysPlatformMapper">

    <resultMap type="ZaSysPlatform" id="ZaSysPlatformResult">
        <result property="id"    column="id"    />
        <result property="name"    column="name"    />
        <result property="code"    column="code"    />
        <result property="ip"    column="ip"    />
        <result property="port"    column="port"    />
        <result property="apis"    column="apis"    />
        <result property="config"    column="config"    />
        <result property="status"    column="status"    />
        <result property="remark"    column="remark"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
    </resultMap>

    <sql id="selectZaSysPlatformVo">
        select id, name, code, ip, port, apis, config, status, remark, create_by, create_time, update_by, update_time from za_sys_platform t
    </sql>

    <select id="selectZaSysPlatformList" parameterType="ZaSysPlatform" resultMap="ZaSysPlatformResult">
        <include refid="selectZaSysPlatformVo"/>
        <where>
            <if test="name != null  and name != ''"> and t.name like concat('%', #{name}, '%')</if>
            <if test="code != null  and code != ''"> and t.code = #{code}</if>
            <if test="status != null  and status != ''"> and t.status = #{status}</if>
        </where>
    </select>

    <select id="selectZaSysPlatformById" parameterType="Long" resultMap="ZaSysPlatformResult">
        <include refid="selectZaSysPlatformVo"/>
        where t.id = #{id}
    </select>
    <select id="selectZaSysPlatformByCode" parameterType="String" resultMap="ZaSysPlatformResult">
        <include refid="selectZaSysPlatformVo"/>
        where t.code = #{code}
    </select>

    <insert id="insertZaSysPlatform" parameterType="ZaSysPlatform" >
        insert into za_sys_platform
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="id != null">id,</if>
            <if test="name != null and name != ''">name,</if>
            <if test="code != null and code != ''">code,</if>
            <if test="ip != null">ip,</if>
            <if test="port != null">port,</if>
            <if test="apis != null">apis,</if>
            <if test="config != null">config,</if>
            <if test="status != null and status != ''">status,</if>
            <if test="remark != null">remark,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="id != null">#{id},</if>
            <if test="name != null and name != ''">#{name},</if>
            <if test="code != null and code != ''">#{code},</if>
            <if test="ip != null">#{ip},</if>
            <if test="port != null">#{port},</if>
            <if test="apis != null">#{apis},</if>
            <if test="config != null">#{config},</if>
            <if test="status != null and status != ''">#{status},</if>
            <if test="remark != null">#{remark},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
        </trim>
    </insert>

    <update id="updateZaSysPlatform" parameterType="ZaSysPlatform">
        update za_sys_platform
        <trim prefix="SET" suffixOverrides=",">
            <if test="name != null and name != ''">name = #{name},</if>
            <if test="code != null and code != ''">code = #{code},</if>
            <if test="ip != null">ip = #{ip},</if>
            port = #{port},
            <if test="apis != null">apis = #{apis},</if>
            <if test="config != null">config = #{config},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="remark != null">remark = #{remark},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteZaSysPlatformById" parameterType="Long">
        delete from za_sys_platform where id = #{id}
    </delete>

    <delete id="deleteZaSysPlatformByIds" parameterType="String">
        delete from za_sys_platform where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>
