{
  "name": "zhian-admin",
  "version": "1.0.0",
  "sourceVersion": "3.8.5",
  "description": "管理系统",
  "author": "Willian",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:stage": "vite build --mode staging",
    "package": "pnpm install",
    "preview": "vite preview",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs --ignore-path .gitignore",
    "lint-fix": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs --fix --ignore-path .gitignore",
    "prepare": "husky"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "src/**/*.{js,vue}": [
      "eslint",
      "git add"
    ]
  },
  "dependencies": {
    "@element-plus/icons-vue": "2.3.1",
    "@vueup/vue-quill": "1.2.0",
    "@vueuse/core": "10.6.1",
    "axios": "0.27.2",
    "crypto-js": "4.1.1",
    "echarts": "5.4.3",
    "element-plus": "2.4.3",
    "file-saver": "2.0.5",
    "fuse.js": "6.6.2",
    "js-cookie": "3.0.5",
    "js-export-word": "^1.0.5",
    "jsencrypt": "3.3.2",
    "md5": "^2.3.0",
    "mitt": "^3.0.0",
    "nprogress": "0.2.0",
    "pinia": "2.1.7",
    "qrcode.vue": "^3.4.0",
    "vue": "3.4.21",
    "vue-cropper": "1.1.1",
    "vue-json-pretty": "^2.4.0",
    "vue-router": "4.3.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "4.5.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "eslint-plugin-vue": "^9.24.0",
    "husky": "^9.0.11",
    "lint-staged": "^15.2.2",
    "prettier": "^3.2.5",
    "sass": "1.69.5",
    "terser": "^5.16.3",
    "unplugin-auto-import": "0.17.1",
    "unplugin-vue-setup-extend-plus": "1.0.0",
    "vite": "^5.1.6",
    "vite-plugin-compression": "0.5.1",
    "vite-plugin-svg-icons": "2.0.1"
  },
  "engines": {
    "node": ">= 16.14.x",
    "pnpm": ">= 7.0.0"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions"
  ]
}
